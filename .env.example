# ────────────────────────────────────────────
# Nudg-Next 환경변수 템플릿
# 실제 값은 .env.local (로컬 개발) 또는 컨테이너 실행 env (운영) 에서 주입.
# 둘 다 .gitignore 됨 — 이 파일만 커밋됨.
# ────────────────────────────────────────────

# 클라이언트(브라우저) → Next.js: 코드 안에서 상대경로 /api 로 고정 호출.
# NEXT_PUBLIC_API_URL 환경변수는 더 이상 사용하지 않음 — 절대 URL 박힐 위험 차단.
# (lib/api/client.ts 의 BASE_URL = "/api" 참조)

# Next.js 서버 → Spring Boot 프록시 대상 (서버 전용, 런타임 env).
# 빌드에 굳지 않음 — 컨테이너 실행 시 -e API_URL=... 또는 docker-compose 로 주입.
#  로컬: API_URL=http://localhost:4000/api
#  운영: API_URL=https://nudg.kr/api
API_URL=https://nudg.kr/api
